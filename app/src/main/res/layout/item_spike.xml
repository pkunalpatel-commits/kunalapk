<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:paddingLeft="3dp"
    android:paddingRight="3dp"
    android:background="#1A2332"
    android:layout_marginBottom="2dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/colTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.05"
        android:textColor="#86EFAC"
        android:textSize="10sp"
        android:maxLines="2" />

    <TextView
        android:id="@+id/colExpiry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:textColor="#E7ECF3"
        android:textSize="10sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/colStrike"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.85"
        android:textColor="#E7ECF3"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/colType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.4"
        android:textColor="#E7ECF3"
        android:textSize="10sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/colWin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.4"
        android:textColor="#8B9BB4"
        android:textSize="10sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/colOiPct"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.75"
        android:textColor="#86EFAC"
        android:textSize="10sp"
        android:gravity="end" />

    <TextView
        android:id="@+id/colLtp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.7"
        android:textColor="#8B9BB4"
        android:textSize="10sp"
        android:gravity="end" />
</LinearLayout>
