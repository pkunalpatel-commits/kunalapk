<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:background="#1A2332"
    android:layout_marginBottom="2dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/colTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:textColor="#86EFAC"
        android:textSize="11sp"
        android:maxLines="2" />

    <TextView
        android:id="@+id/colStrike"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:textColor="#E7ECF3"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/colType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.45"
        android:textColor="#E7ECF3"
        android:textSize="11sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/colWin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.5"
        android:textColor="#8B9BB4"
        android:textSize="11sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/colOiPct"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.85"
        android:textColor="#86EFAC"
        android:textSize="11sp"
        android:gravity="end" />

    <TextView
        android:id="@+id/colLtp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:textColor="#8B9BB4"
        android:textSize="11sp"
        android:gravity="end" />
</LinearLayout>
