<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:layout_marginBottom="2dp">
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:background="#1A2332"
    android:gravity="center_vertical"
    android:minWidth="360dp">

    <TextView
        android:id="@+id/colTime"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:textColor="#86EFAC"
        android:textSize="10sp"
        android:maxLines="2" />

    <TextView
        android:id="@+id/colExpiry"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:textColor="#E7ECF3"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/colStrike"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:textColor="#E7ECF3"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/colType"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:textColor="#E7ECF3"
        android:textSize="10sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/colWin"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:textColor="#8B9BB4"
        android:textSize="10sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/colOi"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:textColor="#8B9BB4"
        android:textSize="10sp"
        android:gravity="end" />

    <TextView
        android:id="@+id/colOiPct"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:textColor="#86EFAC"
        android:textSize="10sp"
        android:gravity="end" />

    <TextView
        android:id="@+id/colLtp"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:textColor="#8B9BB4"
        android:textSize="10sp"
        android:gravity="end" />
</LinearLayout>
</HorizontalScrollView>
