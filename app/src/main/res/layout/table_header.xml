<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingLeft="2dp"
    android:paddingRight="2dp"
    android:background="#243044">

    <TextView android:id="@+id/hdrSymbol" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1.0" android:text="Symbol" android:textColor="#93C5FD" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:id="@+id/hdrTime" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1.15" android:text="Time" android:textColor="#93C5FD" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:id="@+id/hdrExpiry" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1.15" android:text="Exp" android:textColor="#93C5FD" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:id="@+id/hdrStrike" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="0.8" android:text="Strike" android:textColor="#93C5FD" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:id="@+id/hdrType" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="0.4" android:text="CE" android:textColor="#93C5FD" android:textSize="9sp" android:textStyle="bold" android:gravity="center" />
    <TextView android:id="@+id/hdrWin" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="0.4" android:text="Win" android:textColor="#93C5FD" android:textSize="9sp" android:textStyle="bold" android:gravity="center" />
    <TextView android:id="@+id/hdrOi" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1.0" android:text="OI" android:textColor="#93C5FD" android:textSize="9sp" android:textStyle="bold" android:gravity="end" />
    <TextView android:id="@+id/hdrOiPct" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="0.7" android:text="OI%" android:textColor="#93C5FD" android:textSize="9sp" android:textStyle="bold" android:gravity="end" />
    <TextView android:id="@+id/hdrLtp" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="0.65" android:text="LTP" android:textColor="#93C5FD" android:textSize="9sp" android:textStyle="bold" android:gravity="end" />
</LinearLayout>
