<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#0F1419">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OI Spike Detector"
            android:textColor="#E7ECF3"
            android:textSize="17sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnToggleMainExtra"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="Min menu"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: stopped"
        android:textColor="#EF4444"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start" />
        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Stop" />
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Settings" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mainExtraPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <Button
            android:id="@+id/btnHistorical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Historical Scan" />
        <Button
            android:id="@+id/btnLiveExpiries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Live Expiries (Fetch + Tick)" />
    </LinearLayout>

    <!-- Sort bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnSortTimeDesc" android:layout_width="wrap_content"
                android:layout_height="32dp" android:textSize="10sp" android:text="Time ↓" android:minWidth="0dp" android:paddingLeft="8dp" android:paddingRight="8dp" />
            <Button android:id="@+id/btnSortTimeAsc" android:layout_width="wrap_content"
                android:layout_height="32dp" android:textSize="10sp" android:text="Time ↑" android:minWidth="0dp" android:paddingLeft="8dp" android:paddingRight="8dp" />
            <Button android:id="@+id/btnSortOiDesc" android:layout_width="wrap_content"
                android:layout_height="32dp" android:textSize="10sp" android:text="OI% ↓" android:minWidth="0dp" android:paddingLeft="8dp" android:paddingRight="8dp" />
            <Button android:id="@+id/btnSortOiAsc" android:layout_width="wrap_content"
                android:layout_height="32dp" android:textSize="10sp" android:text="OI% ↑" android:minWidth="0dp" android:paddingLeft="8dp" android:paddingRight="8dp" />
            <Button android:id="@+id/btnSortStrikeAsc" android:layout_width="wrap_content"
                android:layout_height="32dp" android:textSize="10sp" android:text="Strike ↑" android:minWidth="0dp" android:paddingLeft="8dp" android:paddingRight="8dp" />
            <Button android:id="@+id/btnSortLtpDesc" android:layout_width="wrap_content"
                android:layout_height="32dp" android:textSize="10sp" android:text="LTP ↓" android:minWidth="0dp" android:paddingLeft="8dp" android:paddingRight="8dp" />
            <Button android:id="@+id/btnSortExpAsc" android:layout_width="wrap_content"
                android:layout_height="32dp" android:textSize="10sp" android:text="Exp ↑" android:minWidth="0dp" android:paddingLeft="8dp" android:paddingRight="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Table header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:background="#243044">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.05"
            android:text="Time" android:textColor="#8B9BB4" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.0"
            android:text="Expiry" android:textColor="#8B9BB4" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.85"
            android:text="Strike" android:textColor="#8B9BB4" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.4"
            android:text="CE/PE" android:textColor="#8B9BB4" android:textSize="10sp" android:textStyle="bold" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.4"
            android:text="Win" android:textColor="#8B9BB4" android:textSize="10sp" android:textStyle="bold" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.75"
            android:text="OI %" android:textColor="#8B9BB4" android:textSize="10sp" android:textStyle="bold" android:gravity="end" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.7"
            android:text="LTP" android:textColor="#8B9BB4" android:textSize="10sp" android:textStyle="bold" android:gravity="end" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/spikeList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Log"
        android:textColor="#8B9BB4"
        android:textStyle="bold"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="2dp"
        android:background="#1A2332"
        android:fillViewport="true">
        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:textColor="#8B9BB4"
            android:textSize="11sp"
            android:text="Log will appear here when scanning…" />
    </ScrollView>
</LinearLayout>
