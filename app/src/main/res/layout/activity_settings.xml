<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1419">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Dhan API" android:textColor="#8B9BB4" android:textStyle="bold" />
        <EditText android:id="@+id/inputClientId" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Client ID" android:textColor="#E7ECF3"
            android:textColorHint="#555" android:inputType="text" />
        <EditText android:id="@+id/inputToken" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Access Token (auto-filled by TOTP)" android:textColor="#E7ECF3"
            android:textColorHint="#555" android:inputType="textMultiLine" android:minLines="2" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Dhan TOTP login (easy token)" android:textColor="#8B9BB4" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Setup: Dhan Web → Access DhanHQ APIs → Setup TOTP → save secret here"
            android:textColor="#555" android:textSize="11sp" />
        <EditText android:id="@+id/inputDhanPin" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Dhan PIN (6 digit)" android:textColor="#E7ECF3"
            android:textColorHint="#555" android:inputType="numberPassword" android:maxLength="6" />
        <EditText android:id="@+id/inputTotpSecret" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="TOTP Secret (Base32 from Dhan QR / key)" android:textColor="#E7ECF3"
            android:textColorHint="#555" android:inputType="textVisiblePassword" />
        <EditText android:id="@+id/inputTotpCode" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Or enter 6-digit TOTP from Authenticator" android:textColor="#E7ECF3"
            android:textColorHint="#555" android:inputType="number" android:maxLength="6" />
        <Button android:id="@+id/btnGenerateToken" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Generate Access Token (TOTP)" />
        <TextView android:id="@+id/tokenStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#86EFAC" android:textSize="12sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Telegram" android:textColor="#8B9BB4" android:textStyle="bold" />
        <EditText android:id="@+id/inputBotToken" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Bot token" android:textColor="#E7ECF3"
            android:textColorHint="#555" />
        <EditText android:id="@+id/inputChatId" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Chat ID(s) comma-separated" android:textColor="#E7ECF3"
            android:textColorHint="#555" />
        <CheckBox android:id="@+id/chkTelegram" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Enable Telegram alerts" android:textColor="#E7ECF3" />
        <Button android:id="@+id/btnTestTelegram" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Test Telegram" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Spike thresholds" android:textColor="#8B9BB4" android:textStyle="bold" />
        <EditText android:id="@+id/inputCandle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Candle interval min (1/3/5/15/30)"
            android:inputType="number" android:textColor="#E7ECF3" android:textColorHint="#555" />
        <CheckBox android:id="@+id/chkStandard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Also check 1m/5m/10m" android:textColor="#E7ECF3" />
        <EditText android:id="@+id/inputOi1" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="1-min OI % min" android:inputType="numberDecimal"
            android:textColor="#E7ECF3" android:textColorHint="#555" />
        <EditText android:id="@+id/inputOi5" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="5-min OI % min" android:inputType="numberDecimal"
            android:textColor="#E7ECF3" android:textColorHint="#555" />
        <EditText android:id="@+id/inputOi10" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="10-min OI % min" android:inputType="numberDecimal"
            android:textColor="#E7ECF3" android:textColorHint="#555" />
        <EditText android:id="@+id/inputPrice" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Price change % min" android:inputType="numberDecimal"
            android:textColor="#E7ECF3" android:textColorHint="#555" />
        <EditText android:id="@+id/inputMinOi" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Min OI" android:inputType="number"
            android:textColor="#E7ECF3" android:textColorHint="#555" />
        <EditText android:id="@+id/inputMinLtp" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Min LTP (skip cheaper options, 0=off)"
            android:inputType="numberDecimal"
            android:textColor="#E7ECF3" android:textColorHint="#555" />
        <EditText android:id="@+id/inputCooldown" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Alert cooldown (min)" android:inputType="number"
            android:textColor="#E7ECF3" android:textColorHint="#555" />
        <EditText android:id="@+id/inputPoll" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Poll interval (sec)" android:inputType="number"
            android:textColor="#E7ECF3" android:textColorHint="#555" />
        <CheckBox android:id="@+id/chkAtm" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="ATM range only" android:textColor="#E7ECF3" />
        <EditText android:id="@+id/inputAtm" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="ATM ± strikes" android:inputType="number"
            android:textColor="#E7ECF3" android:textColorHint="#555" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Symbols" android:textColor="#8B9BB4" android:textStyle="bold" />
        <CheckBox android:id="@+id/chkNifty" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="NIFTY" android:textColor="#E7ECF3" />
        <CheckBox android:id="@+id/chkBank" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="BANKNIFTY" android:textColor="#E7ECF3" />
        <CheckBox android:id="@+id/chkFin" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="FINNIFTY" android:textColor="#E7ECF3" />

        <EditText android:id="@+id/inputExtraSymbols" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Extra F&amp;O symbols (RELIANCE,TCS,CRUDEOIL,...)"
            android:textColor="#E7ECF3" android:textColorHint="#555" android:inputType="textCapCharacters"
            android:minLines="2" />
        <Button android:id="@+id/btnSearchExtra" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Search &amp; add underlying" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Indices + NSE F&amp;O stocks + MCX. Search or type comma-separated."
            android:textColor="#555" android:textSize="11sp" />
        <Button android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Save Settings" />
    </LinearLayout>
</ScrollView>
